  <joint name="aluminium_sheet_holder1_2_fixed" type="fixed">
    <origin xyz="-0.0906712 0.0756221 -0.00296047" rpy="0 0 1.5708"/>
    <parent link="aluminium_sheet"/>
    <child link="aluminium_sheet_holder1_2"/>
  </joint>

  <!-- ========== CAMERA ========== -->
  <link name="camera_link"> <!-- Camera -->

    <inertial>
      <origin xyz="0 -0.0026228 -0" rpy="0 0 0"/>
      <mass value="0.00389726"/>
      <inertia ixx="1.35257e-07" ixy="0" ixz="0" iyy="4.08091e-07" iyz="0" izz="2.91507e-07"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/part_1.stl"/>
      </geometry>
      <material name="part_1_material">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/part_1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.1115 -0.00015 0.037" rpy="0 0 0"/>
    <parent link="aluminium_sheet"/>
    <child link="camera_link"/>
  </joint>

  <!-- ========== CAMERA OPTICAL LINK ========== -->
  <!-- This resolves the orientation difference between Gazebo (X-forward) and ROS (Z-forward) -->
  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
  </joint>

<!-- GAZEBO CAMERA SENSOR -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0.45 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id> <!-- CRITICAL FOR ROS 2 -->
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>896</width>
          <height>896</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- CAMERA INFO PUBLISHER -->
  <gazebo>
    <plugin filename="gz-sim-camera-info-system" name="gz::sim::systems::CameraInfoPublisher">
      <sensor_name>camera</sensor_name>
      <topic_name>/model/my_bot/camera/camera_info</topic_name>
      <frame_name>camera_link</frame_name>
    </plugin>
  </gazebo>

  <!-- ========== PART 2 ========== -->
  <link name="camera_link_2">
    <inertial>
      <origin xyz="-0.000462295 0.02 -0.000262295" rpy="0 0 0"/>
      <mass value="0.0206275"/>
      <inertia ixx="3.5445e-06" ixy="0" ixz="0" iyy="1.58833e-06" iyz="0" izz="3.5445e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/part_1__2.stl"/>
      </geometry>
      <material name="part_1_2_material">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/part_1__2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_link_2_fixed" type="fixed">
    <origin xyz="0.101038 0.000262295 0" rpy="1.5708 0 3.14159"/>
    <parent link="aluminium_sheet"/>
    <child link="camera_link_2"/>
  </joint>

  <!-- ========== MOTOR BRACKET 1 ========== -->
  <link name="aluminium_sheet_motor_bracket">
    <inertial>
      <origin xyz="0 0.00881561 0.0107734" rpy="0 0 0"/>
      <mass value="0.0119613"/>
      <inertia ixx="4.28082e-06" ixy="0" ixz="0" iyy="3.71509e-06" iyz="-1.21896e-06" izz="3.79692e-06"/>
    </inertial>
    <visual>
