    <origin xyz="0.0730882 -0.0672165 -0.0460894" rpy="-3.14159 0 0"/>
    <parent link="aluminium_sheet"/>
    <child link="aluminium_sheet_motor_bracket_4"/>
  </joint>

  <!-- ========== GAZEBO HARMONIC DIFF DRIVE PLUGIN ========== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front</left_joint>
      <left_joint>left_back</left_joint>
      <right_joint>right_front</right_joint>
      <right_joint>right_back</right_joint>
      <wheel_separation>0.251</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publish_wheel_joint_state>true</publish_wheel_joint_state>
      <max_wheel_velocity>10.0</max_wheel_velocity>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <wheel_torque>10.0</wheel_torque>
    </plugin>
  </gazebo>

  <!-- ========== CONTACT PROPERTIES ========== -->
  <gazebo reference="aluminium_sheet">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e5</kp>
    <kd>1000</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
    <material>Gazebo/WoodFloor</material>
  </gazebo>

  <gazebo reference="wheel_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e5</kp>
    <kd>1000</kd>
    <material>Gazebo/Wheel</material>
  </gazebo>

  <gazebo reference="wheel_2_wheel_2">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e5</kp>
    <kd>1000</kd>
    <material>Gazebo/Wheel</material>
  </gazebo>

  <gazebo reference="wheel_3_wheel_3">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e5</kp>
    <kd>1000</kd>
    <material>Gazebo/Wheel</material>
  </gazebo>

  <gazebo reference="wheel_4_wheel_4">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e5</kp>
    <kd>1000</kd>
    <material>Gazebo/Wheel</material>
  </gazebo>


  <!-- ====================================================== -->
  <!-- ==================== TOF SENSORS ===================== -->
  <!-- ====================================================== -->

  <!-- FRONT -->
  <gazebo reference="tof_front_link">
    <sensor name="tof_front" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <topic>/tof/front</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <!-- RIGHT -->
  <gazebo reference="tof_right_link">
    <sensor name="tof_right" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <topic>/tof/right</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <!-- BACK -->
  <gazebo reference="tof_back_link">
    <sensor name="tof_back" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <topic>/tof/back</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <!-- LEFT -->
  <gazebo reference="tof_left_link">
    <sensor name="tof_left" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <topic>/tof/left</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.02</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

</robot>