      <inertia ixx="8.9465e-05" ixy="-5.91112e-07" ixz="4.62013e-06" iyy="4.55969e-05" iyz="2.09552e-05" izz="6.07392e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/holder.stl"/>
      </geometry>
      <material name="holder_2_material">
        <color rgba="0.764706 0.545098 0.803922 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://my_bot/assets/holder.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="aluminium_sheet_holder_2_fixed" type="fixed">
    <origin xyz="0.109329 -0.0757361 -0.00296047" rpy="0 0 -1.5708"/>
    <parent link="aluminium_sheet"/>
    <child link="aluminium_sheet_holder_2"/>
  </joint>

  <!-- ========== HOLDER 4 ========== -->
  <link name="aluminium_sheet_holder1_2">
    <inertial>
      <origin xyz="0.00128255 -0.13544 -0.0119604" rpy="0 0 0"/>
      <mass value="0.144525"/>
      <inertia ixx="8.9465e-05" ixy="5.91112e-07" ixz="4.62013e-06" iyy="4.55969e-05" iyz="-2.09552e-05" izz="6.07392e-05"/>
