    <parent link="aluminium_sheet"/>
    <child link="aluminium_sheet_motor_bracket_2"/>
  </joint>

  <!-- ========== MOTOR BRACKET 3 ========== -->
  <link name="aluminium_sheet_motor_bracket_3">
